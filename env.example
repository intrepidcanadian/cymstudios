# Environment Variables Example

# Password gate for /news articles. Set this to any secret string to lock
# the news article behind a password. Leave unset to keep it locked to
# everyone (the gate denies access when no password is configured).
NEWS_PASSWORD=

# Total gift-card face value (USD) redeemable per day, across all customers.
# The window runs noon-to-noon Eastern (resets 12:00 ET, DST-aware).
# Bounds float exposure so it can be replenished on a predictable cycle.
# Defaults to 1000 when unset.
DAILY_REDEMPTION_CAP_USD=1000
